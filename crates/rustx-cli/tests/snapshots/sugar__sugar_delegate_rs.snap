use std::fmt;
use std::io::{self, Write};

/// Something with an area.
pub trait Shape {
    fn area(&self) -> f64;
    // Provided, so not forwarded.
    fn double(&self) -> f64 {
        self.area() * 2.0
    }
}

/// A writer that also counts lines.
pub struct Logged<W> {
    // Every byte goes here.
    #[delegate(Write)]
    inner: W,
    lines: usize,
}

pub struct Label(u8, #[delegate(Display, Debug)] String);

pub struct Tile {
    #[delegate(Shape)]
    shape: Square,
}

// Adapts the result, which `#[delegate]` would not: stays as written.
pub struct Scaled {
    shape: Square,
}

impl Shape for Scaled {
    fn area(&self) -> f64 {
        Shape::area(&self.shape) * 4.0
    }
}
