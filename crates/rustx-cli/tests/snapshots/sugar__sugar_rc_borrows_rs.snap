//! A shared counter list that borrows explicitly, written without sugar.

use std::cell::RefCell;
use std::rc::Rc;

pub struct Counters {
    pub total: u64,
    pub items: Vec<u64>,
}

pub fn record(counters: &rc Counters, value: u64) -> usize {
    counters.total += value;
    // Each access borrows on its own statement, as the sugar does.
    counters.items.push(value);
    println!("total {}", counters.total);
    counters.items.len()
}

pub fn fresh() -> u64 {
    let seen = rc Vec::new();
    seen.push(1);
    seen.len() as u64
}

pub fn held(counters: rc Counters) -> u64 {
    // A held guard is a borrow the sugar does not write, so every borrow here stays.
    let guard = counters.borrow();
    guard.total + counters.borrow().total
}
