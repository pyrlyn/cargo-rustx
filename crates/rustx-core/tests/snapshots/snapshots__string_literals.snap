mod contacts {
    use std::collections::HashMap;
    #[derive(Debug, Clone)]
    pub struct Contact {
        pub name: String,
        pub email: Option<String>,
        pub tags: Vec<String>,
    }
    impl Contact {
        pub fn new(name: impl ::core::convert::Into<String>) -> Self {
            let name: String = ::core::convert::Into::into(name);
            Contact {
                name,
                email: None,
                tags: Vec::new(),
            }
        }
        pub fn with_email(mut self, email: impl ::core::convert::Into<String>) -> Self {
            let email: String = ::core::convert::Into::into(email);
            self.email = Some(email);
            self
        }
        pub fn tag(mut self, tag: impl ::core::convert::Into<String>) -> Self {
            let tag: String = ::core::convert::Into::into(tag);
            self.tags.push(tag);
            self
        }
        pub fn email_domain(&self) -> Option<&str> {
            self.email.as_deref().and_then(|e| e.split_once('@')).map(|(_, d)| d)
        }
    }
    pub fn demo() -> HashMap<String, Contact> {
        let mut book = HashMap::new();
        let ann = Contact {
            name: ::std::string::String::from("Ann"),
            email: Some(::std::string::String::from("ann@example.com")),
            tags: vec![
                ::std::string::String::from("work"), ::std::string::String::from("vip")
            ],
        };
        book.insert("ann".into(), ann);
        let bob = Contact::new("Bob").with_email("bob@example.org").tag("home");
        book.insert("bob".into(), bob);
        book
    }
}
mod positions {
    pub struct Label {
        pub text: String,
        pub alt: &'static str,
    }
    pub const DEFAULT: &str = "default";
    pub fn greet(name: String, tags: Vec<String>) -> usize {
        name.len() + tags.len()
    }
    pub fn all(label: &mut Label) -> Vec<String> {
        let title: String = ::std::string::String::from("title");
        let mut note: Option<String> = None;
        note = Some(::std::string::String::from(r"raw note"));
        label.text = ::std::string::String::from("changed");
        let size = greet(
            ::std::string::String::from("Ann"),
            vec![::std::string::String::from("a"); 2],
        );
        let kept = Label { text: title, alt: "alt" };
        let untyped = "untyped";
        let bytes: &[u8] = b"bytes";
        let all: Vec<String> = vec![
            ::std::string::String::from("first"), label.text.clone(), kept.text, untyped
            .to_owned(), DEFAULT.into()
        ];
        all
    }
}
