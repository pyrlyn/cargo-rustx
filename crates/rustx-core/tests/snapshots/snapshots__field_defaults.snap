mod server {
    #[derive(Debug, Clone)]
    pub struct ServerConfig {
        pub host: String,
        pub port: u16,
        pub workers: usize,
        pub timeout_ms: u64,
        pub tls: bool,
    }
    impl ::core::default::Default for ServerConfig {
        fn default() -> Self {
            Self {
                host: ::core::convert::Into::into("127.0.0.1"),
                port: 8080,
                workers: 4,
                timeout_ms: 30_000,
                tls: false,
            }
        }
    }
    pub fn dev() -> ServerConfig {
        ServerConfig {
            port: 3000,
            ..::core::default::Default::default()
        }
    }
    pub fn prod(host: &str) -> ServerConfig {
        ServerConfig {
            host: host.to_string(),
            workers: 16,
            tls: true,
            ..::core::default::Default::default()
        }
    }
    pub struct Pool<T>
    where
        T: Clone,
    {
        pub items: Vec<T>,
        #[cfg(feature = "metrics")]
        pub label: std::string::String,
        pub size: usize,
    }
    impl<T> ::core::default::Default for Pool<T>
    where
        T: Clone,
    {
        fn default() -> Self {
            Self {
                items: ::core::default::Default::default(),
                #[cfg(feature = "metrics")]
                label: ::core::convert::Into::into("pool"),
                size: 8,
            }
        }
    }
    pub fn ports(config: &ServerConfig) -> Vec<ServerConfig> {
        let ServerConfig { port, .. } = config;
        let tls = !config.tls;
        match config {
            ServerConfig { tls: true, .. } => vec![],
            _ if matches!(config, ServerConfig { workers : 4, .. }) => {
                vec![
                    ServerConfig { port : * port, .. ::core::default::Default::default()
                    }
                ]
            }
            _ => {
                struct Local {
                    n: u8,
                }
                impl ::core::default::Default for Local {
                    fn default() -> Self {
                        Self { n: 1 }
                    }
                }
                let _ = Local {
                    ..::core::default::Default::default()
                };
                vec![ServerConfig { tls, .. ::core::default::Default::default() }]
            }
        }
    }
}
