    pub fn numbered<
        '__rustx_from_it,
        I: Iterator<Item = &'__rustx_from_it Entry> + '__rustx_from_it,
    >(
        it: I,
    ) -> impl ::core::iter::Iterator<
        Item = (usize, &'__rustx_from_it Entry),
    > + '__rustx_from_it {
        it.enumerate().map(|(i, e)| (i + 1, e))
    }
