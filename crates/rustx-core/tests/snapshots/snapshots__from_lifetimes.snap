mod config {
    use std::collections::HashMap;
    pub struct Config {
        entries: HashMap<String, String>,
    }
    impl Config {
        pub fn get<'__rustx_from_self>(
            &'__rustx_from_self self,
            key: &str,
        ) -> Option<&'__rustx_from_self str> {
            self.entries.get(key).map(|s| s.as_str())
        }
    }
    pub fn first<'__rustx_from_xs>(
        xs: &'__rustx_from_xs [Item],
        key: &str,
    ) -> &'__rustx_from_xs Item {
        &xs[0]
    }
    pub fn longest_value<'__rustx_from_cfg>(
        cfg: &'__rustx_from_cfg Config,
        keys: &[&str],
    ) -> Option<&'__rustx_from_cfg str> {
        let mut best = None;
        for k in keys {
            if let Some(v) = cfg.get(k) {
                if best.map_or(true, |b: &str| v.len() > b.len()) {
                    best = Some(v);
                }
            }
        }
        best
    }
    pub fn section<'__rustx_from_name>(
        name: &'__rustx_from_name str,
        _sep: &str,
    ) -> &'__rustx_from_name str {
        name.split('.').next().unwrap_or(name)
    }
}
