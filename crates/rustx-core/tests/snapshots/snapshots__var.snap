pub struct Stats {
    pub count: usize,
    pub sum: f64,
    pub min: f64,
    pub max: f64,
}
pub fn summarize(samples: &[f64]) -> Option<Stats> {
    if samples.is_empty() {
        return None;
    }
    let mut count = 0;
    let mut sum = 0.0;
    let mut min = f64::MAX;
    let mut max = f64::MIN;
    for &s in samples {
        count += 1;
        sum += s;
        if s < min {
            min = s;
        }
        if s > max {
            max = s;
        }
    }
    Some(Stats { count, sum, min, max })
}
pub fn histogram(samples: &[f64], buckets: usize) -> Vec<usize> {
    let mut out = vec![0; buckets];
    let mut sorted = samples.to_vec();
    sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());
    let lo = sorted[0];
    let hi = sorted[sorted.len() - 1];
    let width = (hi - lo) / buckets as f64;
    for s in sorted {
        let mut idx: usize = ((s - lo) / width) as usize;
        if idx >= buckets {
            idx = buckets - 1;
        }
        out[idx] += 1;
    }
    out
}
fn var(var: i32) -> i32 {
    var + 1
}
