mod generic {
    use std::collections::{HashMap, HashSet};
    use std::fmt::Debug;
    use std::hash::Hash;
    use std::ops::{Add, Mul};
    pub trait Key: Clone + Debug + Eq + Hash + Send + Sync + 'static {}
    impl<
        __RustxSelf: ?::core::marker::Sized + Clone + Debug + Eq + Hash + Send + Sync
            + 'static,
    > Key for __RustxSelf {}
    pub trait Num: Copy + Default + Add<Output = Self> + Mul<Output = Self> {}
    impl<
        __RustxSelf: ?::core::marker::Sized + Copy + Default + Add<Output = __RustxSelf>
            + Mul<Output = __RustxSelf>,
    > Num for __RustxSelf {}
    pub fn dedup_count<K: Key>(items: &[K]) -> HashMap<K, usize> {
        let mut out = HashMap::new();
        for k in items {
            *out.entry(k.clone()).or_insert(0) += 1;
        }
        out
    }
    pub fn first_dup<K: Key>(items: &[K]) -> Option<K> {
        let mut seen = HashSet::new();
        items.iter().find(|k| !seen.insert(*k)).cloned()
    }
    pub fn dot<T: Num>(a: &[T], b: &[T]) -> T {
        a.iter().zip(b).fold(T::default(), |acc, (&x, &y)| acc + x * y)
    }
    pub fn norm_sq<T: Num>(a: &[T]) -> T {
        dot(a, a)
    }
}
