            self.email = email;
            self
        }
        pub fn with_active(mut self, active: bool) -> Self {
            self.active = active;
            self
        }
    }
    pub fn deactivate_by_domain(users: &mut [User], domain: &str) -> usize {
        let mut n = 0;
        for u in users.iter_mut() {
            if u.email().ends_with(domain) && u.active() {
                u.set_active(false);
                n += 1;
            }
        }
        n
    }
}
