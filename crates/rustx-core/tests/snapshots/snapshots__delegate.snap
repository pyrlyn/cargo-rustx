mod io_wrappers {
    use std::io::{self, Read, Write};
    pub struct CountingWriter<W: Write> {
        inner: W,
        pub bytes: usize,
    }
    impl<W> Write for CountingWriter<W>
    where
        W: Write,
    {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            let n = self.inner.write(buf)?;
            self.bytes += n;
            Ok(n)
        }
