mod cache {
    use std::collections::HashMap;
    use std::error::Error;
    use std::fmt::Debug;
    use std::hash::Hash;
    pub struct Cache<K: Eq + Hash + Clone + Debug, V: Clone> {
        map: HashMap<K, V>,
        hits: u64,
    }
    impl<K, V> Cache<K, V>
    where
        K: Eq + Hash + Clone + Debug,
        V: Clone,
    {
        pub fn new() -> Self {
            Cache {
                map: HashMap::new(),
                hits: 0,
            }
        }
        pub fn get_or_insert_with<F, E>(&mut self, key: K, make: F) -> Result<V, E>
        where
            F: FnOnce(&K) -> Result<V, E>,
            E: Debug,
        {
            if let Some(v) = self.map.get(&key) {
                self.hits += 1;
                return Ok(v.clone());
            }
            let v = make(&key)?;
            self.map.insert(key, v.clone());
            Ok(v)
        }
    }
    pub fn warm_up<K, V, I>(cache: &mut Cache<K, V>, items: I)
    where
        K: Eq + Hash + Clone + Debug,
        V: Clone,
        I: IntoIterator<Item = (K, V)>,
    {
        for (k, v) in items {
            cache.map.insert(k, v);
        }
    }
    pub fn run<T, E>(x: T) -> Result<T, E>
    where
        T: Clone + Debug + Send,
        E: Error,
    {
        Ok(x)
    }
    pub trait Store {
        fn put<K, V>(&mut self, key: K, value: V)
        where
            K: Hash + Eq,
            V: Clone;
    }
}
